{
  "name": "spanscope-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:types": "json2ts -i ../schema/profile-v1.schema.json -o src/generated/profile.d.ts --bannerComment ''",
    "check": "npm run generate:types && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run check && npm run notices && vite build && node scripts/inline.mjs",
    "verify:asset": "node scripts/inline.mjs --check",
    "notices": "vite build --sourcemap true && node scripts/notices.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.13.0",
    "ajv": "^8.20.0",
    "echarts": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
