{
  "name": "spanscope-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:types": "json2ts -i ../schema/profile-v1.schema.json -o src/generated/profile.d.ts --bannerComment ''",
    "check": "npm run generate:types && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run check && npm run notices && vite build && node scripts/inline.mjs",
    "verify:asset": "node scripts/inline.mjs --check",
    "notices": "vite build --sourcemap true && node scripts/notices.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.14.26",
    "ajv": "^8.20.0",
    "echarts": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skeinmap": "github:GNP50/skeinmap#2d9790f9517b035fe4fc91e9048d96a5d5f355f3",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  }
}
